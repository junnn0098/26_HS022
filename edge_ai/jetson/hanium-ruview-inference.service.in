[Unit]
Description=Hanium RuView CSI Fall and Respiratory Monitoring
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=-/etc/hanium-ruview-fall.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@APP_DIR@/jetson/run_live.sh
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
