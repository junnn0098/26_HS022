[Unit]
Description=Hanium RuView Fall and Respiratory Status API
After=hanium-ruview-inference.service

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=-/etc/hanium-ruview-fall.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@APP_DIR@/jetson/run_api.sh
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
